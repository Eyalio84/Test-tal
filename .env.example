# Auth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=                    # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=                        # your Google account email — only this email sees /admin

# Database
DATABASE_URL=                       # Neon PostgreSQL connection string

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=              # from: stripe listen --forward-to localhost:3001/api/webhooks/stripe
STRIPE_PRICE_BASIC=price_xxx        # Stripe Price ID for Basic tier (~$9/mo)
STRIPE_PRICE_BUILDER=price_xxx      # Stripe Price ID for Builder tier (~$29/mo)
STRIPE_PRICE_PRO=price_xxx          # Stripe Price ID for Pro tier (~$79/mo)

# Theme + Site
NEXT_PUBLIC_THEME=jewelry           # jewelry | candy | bakery | flowers | wine
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_GEMINI_API_KEY=

# Optional
RESEND_API_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=        # digits only, no + or spaces
